# Required to compile a mission. The simulator, the map, and the test suite start without it.
# Read by api/planner/planner.py. Never commit a real key.
OPEN_AI_API_KEY=your_openai_api_key_here

# Optional. Browser WebSocket base for the session stream.
# Defaults to ws://127.0.0.1:8000 when unset.
NEXT_PUBLIC_WS_URL=ws://127.0.0.1:8000
